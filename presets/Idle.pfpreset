            "type": "Number",
            "value": 0.5
          }
        }
      },
      {
        "type": "ExprAssign",
        "target": "faceYaw",
        "value": {
          "type": "Binary",
          "op": "+",
          "left": {
            "type": "Binary",
            "op": "*",
            "left": {

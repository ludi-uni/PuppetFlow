  "behaviorPfScript": "-- 体の揺れ（ゆったり）\nbodyLean = oscillator(id = \"idle-body-lean\", frequency = 0.12) * 0.04 * clamp(interest, 0.2, 1) + 0.5\nbodyRoll = oscillator(id = \"idle-body-roll\", frequency = 0.09) * 0.03 * clamp(interest, 0.2, 1) + 0.5\nfaceYaw = oscillator(id = \"idle-face-yaw\", frequency = 0.07) * 0.015 + 0.5\nheadTilt = oscillator(id = \"idle-head-tilt\", frequency = 0.05) * 0.01 + 0.5\nbodyYaw = interest * -0.15 + 0.5\nmouthY = volume\neyeYaw = clamp(energy, 0.35, 1)\nbreath = breath(0.08)",
  "behaviorPlugins": [
    {
      "id": "blink",
      "config": {
        "minInterval": 3.5,
        "maxInterval": 8.5,
        "closeDuration": 0.13,
        "blinkStrength": 1
      }
    },
    {
      "id": "idle",
      "config": {
        "interestThreshold": 0.5,
        "wanderBoost": 0.07
      }
    }
  ],
  "graph": {
    "nodes": [
      {
        "id": "interest",
        "type": "stateInput",
        "data": {
          "key": "interest"
        },
        "position": {
          "x": 0,
          "y": 80
        }
      },
      {
        "id": "multiply",
        "type": "multiply",
        "data": {
          "gain": 0.4
        },
        "position": {
          "x": 220,
          "y": 80
        }
      },
      {
        "id": "mouthX",
        "type": "output",
        "data": {
          "key": "mouthX"
        },
        "position": {
          "x": 460,
          "y": 80
        }
      }
    ],
    "edges": [
      {
        "id": "e1",
        "source": "interest",
        "target": "multiply"
      },
      {
        "id": "e2",
        "source": "multiply",
        "target": "mouthX"
      }
    ]
  },
  "extensions": {
    "packs": []
  }
}

                      "value": 0.09
                    }
                  }
                ]
              },
              "right": {
                "type": "Number",
                "value": 0.03
              }
            },
            "right": {
              "type": "Call",
              "callee": "clamp",
              "args": [
                {
                  "value": {
                    "type": "Identifier",
                    "name": "interest"
                  }
                },
                {
                  "value": {
                    "type": "Number",
                    "value": 0.2
                  }
                },
                {
                  "value": {
                    "type": "Number",
                    "value": 1
                  }
                }
              ]
            }
          },
